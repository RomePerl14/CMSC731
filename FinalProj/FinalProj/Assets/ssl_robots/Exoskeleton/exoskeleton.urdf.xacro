    <axis xyz="0 0 1" />
    <limit effort="1000.0" lower="-0.523599" upper="-0.1309" velocity="0.0"/>
    <safety_controller k_velocity="1" k_position="1"
      soft_lower_limit="-3" soft_upper_limit="3" />
  </joint>


