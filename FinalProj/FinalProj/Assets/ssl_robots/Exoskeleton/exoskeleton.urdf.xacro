<?xml version="1.0"?>

<robot name="exoskeleton" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- max LS length is 0.0753 (75.3 mm) -->
  <!-- <xacro:arg name="LS_length_param" default="0.0753"/> -->
  <xacro:property name="LS_length_param" value="0.0753"/>

  <!-- max LU length is 0.0559 (55.9 mm) -->
  <!-- <xacro:arg name="LU_length_param" default="55.9"/> -->
  <xacro:property name="LU_length_param" value="0.0559"/>

  <!-- max LF length is 0.0969 (96.9 mm) -->
  <!-- <xacro:arg name="LF_length_param" default="0"/> -->
  <xacro:property name="LF_length_param" value="0.0969"/>

  <!-- max LH length is 0.0537 (53.7 mm) -->
  <!-- <xacro:arg name="LH_length_param" default="0.0537"/> -->
  <xacro:property name="LH_length_param" value="0.0537"/>

<!-- LS passive link macros -->
  <xacro:macro name="LS_link_length" params="LS_input_length">
      <!-- Check to make sure the inputted length is actually feasible adjustments on exos. If not, set them to the min and max (depending on where it is) -->
      <xacro:if value="${LS_input_length > 0.0753}">
        <xacro:property name="LS_length" value="0.0753"/>
      </xacro:if>
      <xacro:if value="${0 > LS_input_length}">
        <xacro:property name="LS_length" value="0"/>
      </xacro:if>
      <xacro:if value="${LS_input_length >= 0 and 0.0753 >= LS_input_length}">
        <xacro:property name="LS_length" value="${LS_input_length}"/>
      </xacro:if>
      <!-- convert the value according to URDF geometry -->
      <!-- 
        The values 0.065211.. and 0.03765 are "0" values, as in the extension of the links are 0mm from the minimum if the input is 0
        these are generated by doing the max delta of the LS link, 75.3 mm, and multiplying it by cos(30) and sin(30) respectively. 
        This is required because at it's 0 positions, exoskeletons first link is 30 degrees from the z (up) axis, so URDF translations
        along the horinzontal axis move the rotated part along the horiztonal axis, not along the plane of the "T" section of the link
        You need to use a geometric relation, in this case a 30-60-90 triangle in order to get the input to translate along the plane
        of the "T" link correctly, or else it simply translates horizontally along the horizontal plane of the global axis -Romeo
       -->
      <origin xyz="${(0.0753*cos(0.523599))-(LS_length*cos(0.523599))} ${(0.0753*sin(0.523599))-(LS_length*sin(0.523599))} 0" rpy="1.5708 0 0.523599" /> 
  </xacro:macro>

  <xacro:macro name="LS_link_transform" params="LS_input_length">
    <!-- Same conditionals as above, check to make sure it's in our boundaries -->
    <xacro:if value="${LS_input_length > 0.0753}">
        <xacro:property name="LS_length" value="0.0753"/>
    </xacro:if>
    <xacro:if value="${0 > LS_input_length}">
        <xacro:property name="LS_length" value="0"/>
    </xacro:if>
    <xacro:if value="${LS_input_length >= 0 and 0.0753 >= LS_input_length}">
        <xacro:property name="LS_length" value="${LS_input_length}"/>
    </xacro:if>
    <!-- take the desired input length, and do the math on it to spit out the correct a and d dh params -->
    <!-- 
      In order to change the URDF visual corretly, we need to adjust x and y as if they were a and d from the
      DH param table in the Exos Kinematic Guide 2.0. This being the case, we can use the provided equations
      to convert our input (which is LS in this case) to the correct a and d distances
     -->
    <xacro:property name="LS" value="${0.1365+LS_length}"/>
    <xacro:property name="LSG" value="${sqrt((LS*LS) + ((0.173629-0.161245)*(0.173629-0.161245)))}"/>
    <xacro:property name="Beta" value="${acos(LS/LSG)}"/>
    <xacro:property name="a" value="${LSG*cos(0.523599+Beta)}"/>
    <xacro:property name="d" value="${LSG*sin(0.523599+Beta)}"/>
    <!-- negative because thats what the URDF wants -->
    <origin xyz="${a*-1} ${d*-1} 0" rpy="1.5708 0 0"/>
  </xacro:macro>

<!-- LU passive link macros -->
  <xacro:macro name="LU_link_length" params="LU_input_length">
    <!-- conditional to check if we're in the range of LU -->
    <xacro:if value="${LU_input_length > 0.0559}">
        <xacro:property name="LU_length" value="0.0559"/>
    </xacro:if>
    <xacro:if value="${0 > LU_input_length}">
        <xacro:property name="LU_length" value="0"/>
    </xacro:if>
    <xacro:if value="${LU_input_length >= 0 and 0.0559 >= LU_input_length}">
        <xacro:property name="LU_length" value="${LU_input_length}"/>
    </xacro:if>
    <!-- 
      The relationship between the change in distance for these links is a 45-45-90 triangle, so for a desired
      hypotnuse length, find the subsequent adjacent lengths. Changing the lengths involves subtracting the input/sqrt(2)
      from the y value, and adding the input/sqrt(2) to the z value. This being the case, the max input allowed
      is .0559/sqrt(2), where .0559 is 55.9 mm, or the allowed delta provided in the Exos kinematic Guide 2.0
    -->
    <!-- 
      Here, 0.210717... is the value that puts the link at 0 extension (0mm from minimum) if the input is 0.
      Its found by taking the minimum link value 298 mm (from Exos kinematic guide 2.0) and dividing by sqrt(2)
      -->
    <xacro:property name="y_value" value="${(-0.298/sqrt(2)) - (LU_length/sqrt(2))}"/>
    <xacro:property name="z_value" value="${(-0.298/sqrt(2)) + (LU_length/sqrt(2))}"/>
    <origin xyz="0 ${y_value} ${z_value}" rpy="-0.785398 0 0" />
  </xacro:macro>

  <xacro:macro name="LU_link_transform" params="LU_input_length">
    <xacro:LU_link_length LU_input_length="${LU_input_length}"/>
  </xacro:macro>

<!-- LF passive link macros -->
  <xacro:macro name="LF_link_length" params="LF_input_length">
    <!-- Check to make sure the input length is in the range -->
    <xacro:if value="${LF_input_length > 0.0969}">  
          <xacro:property name="LF_length" value="0.0969"/>
    </xacro:if>
    <xacro:if value="${0 > LF_input_length}">
        <xacro:property name="LF_length" value="0"/>
    </xacro:if>
    <xacro:if value="${LF_input_length >= 0 and 0.0969 >= LF_input_length}">
        <xacro:property name="LF_length" value="${LF_input_length}"/>
    </xacro:if>
    <!-- 
      The relationship of xyz for the LF link is SUPER easy. All it is is subtract the input length from the y value.
      -0.2337 is the length at which the link is at 0 extension (0mm from the minimum) if the input is 0
      -0.2337 is the minimum value for the link length listed in the Exos Kinematic Guide 2.0
    -->
    <origin xyz="0 ${-0.2337-LF_length} 0" rpy="1.5708 -1.5708 0" />
  </xacro:macro>

  <xacro:macro name="LF_link_transform" params="LF_input_length">
    <!-- Check to make sure the input length is in the range -->
    <xacro:if value="${LF_input_length > 0.0969}">  
          <xacro:property name="LF_length" value="0.0969"/>
    </xacro:if>
    <xacro:if value="${0 > LF_input_length}">
        <xacro:property name="LF_length" value="0"/>
    </xacro:if>
    <xacro:if value="${LF_input_length >= 0 and 0.0969 >= LF_input_length}">
        <xacro:property name="LF_length" value="${LF_input_length}"/>
    </xacro:if>
    <!-- 
      The relationship of xyz for the LF link is SUPER easy. All it is is subtract the input length from the y value.
      -0.2337 is the length at which the link is at 0 extension (0mm from the minimum) if the input is 0
      -0.2337 is the minimum value for the link length listed in the Exos Kinematic Guide 2.0
    -->
    <origin xyz="0 ${-0.2337-LF_length} 0" rpy="-1.5708 3.14159 0"/>
  </xacro:macro>

<!-- LH passive link macros -->
  <xacro:macro name="LH_link_length" params="LH_input_length">
    <!-- Check to make sure the input length is in the range -->
    <xacro:if value="${LH_input_length > 0.0537}">  
          <xacro:property name="LH_length" value="0.0537"/>
    </xacro:if>
    <xacro:if value="${0 > LH_input_length}">
        <xacro:property name="LH_length" value="0"/>
    </xacro:if>
    <xacro:if value="${LH_input_length >= 0 and 0.0537 >= LH_input_length}">
        <xacro:property name="LH_length" value="${LH_input_length}"/>
    </xacro:if>
    <!-- 
      The relationship xyz for LH is also super easy, all it is is subtract the input length from the x value 
      -0.0537 is the length at which the link is at 0 extension (0mm from the minimum) if the input is 0
      -0.0537 is the minimum value for the link length listed in The Exos Kinematic Guide 2.0 
    -->
    <origin xyz="${-0.0537+LH_length} 0 0" rpy="0 0 0" />
  </xacro:macro>

