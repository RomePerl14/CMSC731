    <!-- link8_FOREARM_STRAP -->
    <!-- LF passive link... lengthy, aint it? -->
    <visual>
      <!-- 
      The relationship of xyz for the LF link is SUPER easy. All it is is subtract the input length from the y value.
      -0.2337 is the length at which the link is at 0 extension (0mm from the minimum) if the input is 0
      -0.2337 is the minimum value for the link length listed in the Exos Kinematic Guide 2.0
    -->
